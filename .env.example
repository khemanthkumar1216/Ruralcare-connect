# RuralCare Connect Environment Configuration Template

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Defaults to embedded SQLite with strict constraints)
DATABASE_URL=file:./ruralcare.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# JWT Secret for Staff Authentication
JWT_SECRET=ruralcare_jwt_secure_key_change_in_production_2026
JWT_EXPIRES_IN=24h

# Frontend API URL
VITE_API_BASE_URL=http://localhost:4000/api
